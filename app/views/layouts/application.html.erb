<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Greatest Per Group in Rails" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Greatest Per Group in Rails">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="container">
        <%= link_to "Greatest Per Group in Rails", root_path, class: "brand" %>
        <nav>
          <ul>
            <% {
              "N+1 Query" => authors_path,
              "Custom Query Methods" => custom_query_methods_authors_path,
              "Scoped has_one Association" => scoped_has_one_authors_path,
              "View Backed Model" => view_backed_model_authors_path
            }.each do |label, path| %>
              <li><%= link_to label, path, aria: { current: ("page" if current_page?(path)) } %></li>
            <% end %>
          </ul>
        </nav>
      </div>
    </header>

    <main class="container">
      <%= yield %>

      <section class="about">
        <h4>About this App</h4>
        <p>This Ruby on Rails app demonstrates the concepts encompassed in <%= link_to "a series of blog posts about Greatest Per Group queries in Rails", "http://www.toasterlovin.com/greatest-per-group-postgresql-distinct-on/" %>. You can <%= link_to "view the source code on GitHub", "https://github.com/toasterlovin/rails-greatest-per-group" %>.</p>
      </section>
    </main>
  </body>
</html>
